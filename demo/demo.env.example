# Copy this file to demo.env and fill it in. demo.env is ignored by git.

# Where the app is running (npm run dev in the project folder)
APP_URL=http://localhost:5173

# A shopper account whose email is verified (checkout refuses unverified emails)
SHOPPER_EMAIL=
SHOPPER_PASSWORD=

# An admin account: sign up, then set role to "admin" on its document in Firestore → users
ADMIN_EMAIL=
ADMIN_PASSWORD=

# A product photo for visual search (a path relative to this folder, or a full path)
PHOTO=

# Sample delivery details typed at checkout. Don't use your real address on camera.
DELIVERY_PHONE=01700000000
DELIVERY_ADDRESS=House 12, Road 5, Dhanmondi, Dhaka

# What the demo types
CHAT_QUESTION=Do you have any hoodies in size M?
ANALYST_QUESTION=Which category earned the most revenue?
PRODUCT_TITLE=Classic Leather Sneakers
MAX_PRICE=5000

# Which product (0 = first in the shop) the demo buys, and how many orders "prepare" places
PRODUCT_INDEX=0
SAMPLE_ORDERS=4

# Browser size (16:9) and pace: SPEED=2 plays twice as fast, 0.5 half as fast
WINDOW=1440x810
SPEED=1
CAPTIONS=on

# on = also save Playwright's own recording to demo/videos (lower quality than a screen recording)
RECORD_VIDEO=off

# on = run without a window and stop at the first failed step (for checking the script)
HEADLESS=off
